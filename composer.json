{
    "name": "yananob/sports-center-open-day",
    "description": "Sports Center Open Day investigation and notification",
    "license": "proprietary",

    "require": {
        "php": ">= 8.2",
        "google/cloud-functions-framework": "^1.3",
        "nesbot/carbon": "^3.8",
        "monolog/monolog": "^3.10",
        "google/cloud-firestore": "^2.2",
        "guzzlehttp/guzzle": "^7.8",
        "eftec/bladeone": "^4.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "./src/"
        }
    },
    "autoload-dev": {
